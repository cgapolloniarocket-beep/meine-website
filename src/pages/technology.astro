---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import TokamakFieldLines from '../components/TokamakFieldLines.astro';
---

<Layout title="Apollonia – Coming Soon">
  <section class="technology-page">
    <SiteHeader transition:persist />

    <div class="hero-text">
      <h1>
        PROTOTYPE
        <br />
        IN PROGRESS.
      </h1>
    </div>

    <div class="tokamak-stage">
      <TokamakFieldLines />
    </div>
  </section>
</Layout>

<style>
  /* The title box matches the Home hero (index.astro) at every breakpoint,
     so the headline sits in the same place on both pages. */
  .technology-page {
    position: relative;
    height: 100vh;
    overflow: hidden;
    background-color: #000000;
  }

  .hero-text {
    position: relative;
    z-index: 4;
    pointer-events: none;
    padding: 10rem 4rem 0;
  }

  h1 {
    font-family: 'Barlow', sans-serif;
    font-size: clamp(2rem, 6vw, 5rem);
    font-weight: 800;
    line-height: 0.95;
    color: #ffffff;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    margin: 0;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.5);
  }

  /* Field lines on the right, where the globe sits on Home */
  .tokamak-stage {
    position: absolute;
    z-index: 2;
    top: 9rem;
    bottom: 2rem;
    left: 46%;
    right: 2rem;
  }

  @media (max-width: 768px) {
    .hero-text {
      padding: 8.5rem 1.5rem 0 2.5rem;
      max-width: 58%;
    }

    h1 {
      font-size: 1.9rem;
      line-height: 1.1;
    }

    .tokamak-stage {
      top: 16.5rem;
      left: 1rem;
      right: 1rem;
      bottom: 1.5rem;
    }
  }

  @media (max-width: 380px) {
    .hero-text {
      padding: 6.5rem 1.2rem 0;
      max-width: 60%;
    }

    h1 {
      font-size: 1.6rem;
    }

    .tokamak-stage {
      top: 12.5rem;
    }
  }
</style>
