---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import TokamakFieldLines from '../components/TokamakFieldLines.astro';
import Applications from '../components/Applications.astro';
---

<Layout
  title="Technology – Apollonia Space"
  description="Apollonia Space is developing plasma propulsion for satellites, interplanetary cargo and interplanetary spacecraft."
  image="/og-technology.png"
>
  <section class="technology-page">
    <SiteHeader transition:persist />

    <div class="tech-layout">
      <div class="tech-left">
        <div class="hero-text">
          <h1>
            PROTOTYPE
            <br />
            IN PROGRESS.
          </h1>
        </div>

        <div class="tokamak-stage">
          <TokamakFieldLines />
        </div>
      </div>

      <Applications />

      <!-- quiet line from the tokamak to the applications rail (drawn by vehicles.js) -->
      <svg class="rail-link" data-rail-link aria-hidden="true"></svg>
    </div>
  </section>
</Layout>

<style>
  /* The title box matches the Home hero (index.astro) at every breakpoint,
     so the headline sits in the same place on both pages. */
  .technology-page {
    position: relative;
    min-height: 100vh;
    overflow: hidden;
    background-color: #000000;
  }

  /* left: title + tokamak; right: applications. The left column starts at the
     page's top-left corner, so the title box is unchanged. */
  .tech-layout {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  }

  .tech-left {
    min-width: 0;
  }

  .rail-link {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    overflow: visible;
    pointer-events: none;
  }

  .rail-link :global(path) {
    fill: none;
    stroke: #a28aee;
    stroke-width: 1.2;
    stroke-opacity: 0.45;
  }


  .hero-text {
    position: relative;
    z-index: 4;
    pointer-events: none;
    padding: 10rem 4rem 0;
  }

  h1 {
    font-family: 'Barlow', sans-serif;
    font-size: clamp(2rem, 6vw, 5rem);
    font-weight: 800;
    line-height: 0.95;
    color: #ffffff;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    margin: 0;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.5);
  }

  /* Field lines under the title, moved towards the page centre, about 2 cm below (3rem + the view's inner margin) */
  .tokamak-stage {
    position: relative;
    z-index: 2;
    width: clamp(260px, 30vw, 460px);
    margin: 3rem 0 4rem 12rem;
  }

  /* desktop: two shared bands. Band 1 = title | applications header (same top
     and bottom line); band 2 = tokamak | list, with the tokamak centred on the
     middle vehicle so the connector runs straight. The tokamak sits midway
     between the title's left edge and the rail. */
  @media (min-width: 1025px) {
    .tech-layout {
      --fs: clamp(2rem, 6vw, 5rem);              /* = h1 font-size */
      --band: calc(1.9 * var(--fs));             /* two title lines at line-height 0.95 */
      --rows: calc(1.25 * clamp(260px, 30vw, 460px));   /* height of the three vehicle rows */
      --stage: calc(0.7 * var(--rows));          /* tokamak view: same size ratio to the vehicles as before */
      --gap: 3rem;
      --eyebrow-nudge: calc(0.175 * var(--fs) - 0.29rem);
      --lede-nudge: 0px;
    }

    .tokamak-stage {
      width: var(--stage);
      margin: calc(var(--gap) + (var(--rows) - var(--stage)) / 2) 0 4rem calc(50% + 2.675rem - var(--stage) / 2);
    }
  }

  /* tablets and narrower: applications move below the tokamak */
  @media (max-width: 1024px) {
    .tech-layout {
      grid-template-columns: minmax(0, 1fr);
    }

    .rail-link {
      display: none;
    }

  }

  @media (max-width: 768px) {

    .hero-text {
      padding: 8.5rem 1.5rem 0 2.5rem;
      max-width: 58%;
    }

    h1 {
      font-size: 1.9rem;
      line-height: 1.1;
    }

    .tokamak-stage {
      width: auto;
      max-width: 420px;
      margin: 2.5rem 1.5rem 2rem 2.5rem;
    }
  }

  @media (max-width: 380px) {
    .hero-text {
      padding: 6.5rem 1.2rem 0;
      max-width: 60%;
    }

    h1 {
      font-size: 1.6rem;
    }

    .tokamak-stage {
      margin: 2rem 1.2rem 2rem;
    }
  }
</style>
