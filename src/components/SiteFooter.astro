  </div>

  <div class="footer-base">
    <a class="brand" href="/">
      <img src="/apollonia_logo_white_black.png" alt="Apollonia Space" class="footer-logo" />
      <span class="footer-brand-name">Apollonia Space</span>
    </a>
    <small>© 2026 Apollonia Space. All rights reserved.</small>
  </div>
</footer>

<style>
  /* ─── Get in touch ─── */
  .contact {
    background: #000;
    padding: clamp(3rem, 6vw, 5rem) 2rem clamp(3rem, 6vw, 4rem);
  }

  .contact-box {
    position: relative;
    max-width: 1400px;
    margin: 0 auto;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 20px;
    background:
      radial-gradient(120% 120% at 12% 50%, rgba(66, 165, 245, 0.10) 0%, rgba(66, 165, 245, 0) 55%),
      rgba(255, 255, 255, 0.02);
    overflow: hidden;
  }

  .contact-content {
    position: relative;
    z-index: 1;
    padding: clamp(2.5rem, 5vw, 4rem) clamp(2rem, 5vw, 4.5rem);
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: start;
  }

  .contact-head {
    padding-top: 0;
  }

  .contact-title {
    font-family: 'Barlow', sans-serif;
    font-weight: 800;
    font-size: clamp(2rem, 4vw, 3.5rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    color: #ffffff;
    margin: 0;
    text-transform: uppercase;
  }

  .contact-details {
    display: flex;
    align-items: center;
    gap: clamp(2.5rem, 5vw, 4rem);
    flex-wrap: nowrap;
    justify-content: flex-end;
    padding-top: 2px;
  }

  .inquiry {
    display: flex;
    flex-direction: column;
  }

  .inquiry-label {
    font-family: 'Montserrat', sans-serif;
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.5);
    margin: 0 0 0.25rem;
  }

  .inquiry a {
    font-family: 'Montserrat', sans-serif;
    font-size: clamp(1.15rem, 2.2vw, 1.45rem);
    font-weight: 500;
    color: #ffffff;
    text-decoration: none;
    border-bottom: none;
    padding-bottom: 6px;
    transition: color 0.25s ease;
    white-space: nowrap;
  }

  .inquiry a:hover {
    color: #42A5F5;
  }

  .inquiry-divider {
    width: 1px;
    align-self: stretch;
    min-height: 70px;
    background: rgba(255, 255, 255, 0.16);
  }

  @media (max-width: 1200px) {
    .contact-details {
      justify-content: flex-start;
    }
  }

  @media (max-width: 1024px) {
    .contact-content {
      grid-template-columns: 1fr;
      gap: 3rem;
      align-items: start;
    }
    .contact-details {
      padding-top: 0;
    }
  }

  @media (max-width: 680px) {
    .contact {
      padding: 2.5rem 1rem 2.5rem;
    }

    .contact-box {
      border-radius: 14px;
    }

    .contact-details {
      flex-direction: column;
      align-items: flex-start;
      gap: 2rem;
    }

    .inquiry-divider {
      display: none;
    }

    .inquiry a {
      white-space: normal;
      word-break: break-all;
    }
  }

  /* ─── Footer line ─── */
  .footer-line {
    width: 100%;
    height: 2px;
    background: linear-gradient(to right, #050d1a, #ffffff, #050d1a);
    display: block;
    position: relative;
    z-index: 10;
  }

  /* ─── Footer ─── */
  .site-footer {
    background: #000;
    color: #fff;
    padding: 3.5rem 4rem 3rem;
    font-family: 'Barlow', sans-serif;
  }

  .footer-inner {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    gap: 6rem;
    align-items: flex-start;
    padding-bottom: 4rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .footer-inner > .fcol:first-child {
    margin-left: 36%;
  }

  /* ─── Footer columns ─── */
  .fcol h5 {
    font-family: 'Barlow', sans-serif;
    font-size: 1.1rem;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: 0.1em;
    margin-top: 0;
    margin-bottom: 1.5rem;
  }

  .fcol ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .fcol ul li a {
    color: rgba(255, 255, 255, 0.5);
    text-decoration: none;
    font-size: 1rem;
    font-weight: 500;
    transition: color 0.3s;
  }

  .fcol ul li a:hover {
    color: #ffffff;
  }

  .social {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  /* ─── Footer base ─── */
  .footer-base {
    max-width: 1400px;
    margin: 2rem auto 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: #ffffff;
  }

  .footer-logo {
    height: 40px;
    width: auto;
    display: block;
  }

  .footer-brand-name {
    font-family: 'Montserrat', sans-serif;
    font-size: 0.9rem;
    font-weight: 400;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    white-space: nowrap;
    color: #ffffff;
  }

  small {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.3);
  }

  @media (max-width: 1024px) {
    .footer-inner {
      gap: 2rem;
    }

    .footer-inner > .fcol {
      flex: 1;
    }

    .footer-inner > .fcol:first-child {
      margin-left: 0;
    }

    .site-footer {
      padding: 4rem 2rem 3rem;
    }

    .footer-base {
      flex-direction: column;
      gap: 1rem;
      text-align: center;
    }
  }

  @media (max-width: 600px) {
    .site-footer {
      padding: 3rem 1.5rem 2.5rem;
    }

    .footer-inner {
      gap: 2.5rem 1rem;
    }

    .fcol h5 {
      font-size: 1rem;
    }

    .fcol ul li a {
      font-size: 0.9rem;
    }

    .social {
      gap: 0.5rem;
    }

    .footer-base {
      margin-top: 1.5rem;
    }
  }
</style>