---
// Applications.astro — the three mission classes the thruster is built for.
// Concept illustrations (src/lib/tokamak/vehicles.js); no product claims.
const items = [
  { kind: 'satellite', name: 'Satellites', text: 'Orbit raising, station-keeping and end-of-life deorbit.' },
  { kind: 'cargo', name: 'Interplanetary Cargo', text: 'Moving freight between Earth orbit, the Moon and Mars.' },
  { kind: 'spacecraft', name: 'Interplanetary Spacecraft', text: 'Deep-space transfer for science and exploration missions.' },
];
---

<section class="applications" aria-labelledby="applications-title">
  <header class="apps-head">
    <h2 class="apps-eyebrow" id="applications-title">Applications</h2>
    <p class="apps-lede">One engine. <br class="lede-br" />Three missions.</p>
  </header>
  <ol class="apps-list">
    {items.map((it) => (
      <li class="app" data-app={it.kind}>
        <div class="app-art" data-app-art={it.kind} aria-hidden="true"></div>
        <div class="app-text">
          <h3 class="app-name">{it.name}</h3>
          <p class="app-line">{it.text}</p>
        </div>
      </li>
    ))}
  </ol>
  <div class="apps-canvas" data-apps-canvas aria-hidden="true"></div>
</section>

<script>
  let api: { destroy(): void } | null = null;

  // start the 3D only when it comes into view (saves work for visitors who never scroll there)
  function whenVisible(el: Element, fn: () => void) {
    if (!('IntersectionObserver' in window)) { fn(); return; }
    const io = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) { io.disconnect(); fn(); }
    }, { rootMargin: '200px' });
    io.observe(el);
  }

  function mountApplications() {
    const root = document.querySelector<HTMLElement>('.applications');
    if (!root || root.dataset.mounted === 'true') return;
    root.dataset.mounted = 'true';
    whenVisible(root, async () => {
      const { mountVehicles } = await import('../lib/tokamak/vehicles.js');
      if (!root.isConnected) return;
      api = mountVehicles(root);
    });
  }

  document.addEventListener('astro:page-load', mountApplications);
  document.addEventListener('astro:before-swap', () => {
    api?.destroy();
    api = null;
  });
</script>

<style>
  .applications {
    position: relative;
    z-index: 3;
    padding: 10rem 4rem 4rem 1rem;
  }

  .apps-eyebrow {
    margin: 0;
    animation: none;
    line-height: 1.4;
    font-family: 'Montserrat', sans-serif;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #a28aee;
  }

  .apps-lede {
    margin: 0.4rem 0 1.5rem;
    font-family: 'Barlow', sans-serif;
    font-weight: 400;
    font-size: clamp(1.2rem, 1.8vw, 1.7rem);
    line-height: 1.15;
    color: #ffffff;
  }

  .apps-list {
    list-style: none;
    margin: 0;
    padding: 0 0 0 1.75rem;
    display: flex;
    flex-direction: column;
  }

  /* one thin vertical rail down the list, one node per vehicle */
  .app {
    position: relative;
  }

  .app::after {
    content: '';
    position: absolute;
    left: -1.4rem;
    top: 0;
    bottom: 0;
    width: 1px;
    background: rgba(162, 138, 238, 0.45);
  }

  .app:first-child::after {
    top: 50%;
  }

  .app:last-child::after {
    bottom: 50%;
  }

  .app::before {
    content: '';
    position: absolute;
    left: calc(-1.4rem - 3.5px);
    top: 50%;
    width: 8px;
    height: 8px;
    margin-top: -4px;
    border-radius: 50%;
    background: #a28aee;
    transition: transform 0.3s, background-color 0.3s;
  }

  .app:hover::before {
    transform: scale(1.5);
    background: #c8b9ff;
  }

  .app {
    display: grid;
    grid-template-columns: minmax(0, 46%) minmax(0, 1fr);
    align-items: center;
    gap: 1.25rem;
    padding: 0.9rem 0;
  }

  .app-art {
    aspect-ratio: 16 / 10;
    width: 100%;
  }


  .app-text {
    min-width: 0;
    container-type: inline-size;
  }

  .app-name {
    margin: 0 0 0.35rem;
    font-family: 'Barlow', sans-serif;
    font-weight: 800;
    font-size: 1.1rem;
    font-size: clamp(0.8rem, 6.8cqi, 1.4rem);   /* scales with its column so every name stays on one line */
    line-height: 1.05;
    white-space: nowrap;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: #ffffff;
    transition: color 0.3s;
  }

  .app:hover .app-name {
    color: #c8b9ff;
  }

  .app-line {
    margin: 0;
    font-family: 'Montserrat', sans-serif;
    font-weight: 300;
    font-size: 0.92rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.72);
    max-width: 32ch;
  }

  .apps-canvas {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  /* desktop: header shares the title's band, the list shares the tokamak's band
     (sizes come from technology.astro; without them the list just flows) */
  @media (min-width: 1025px) {
    .apps-head {
      height: var(--band, auto);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .apps-eyebrow {
      margin-top: var(--eyebrow-nudge, 0px);
    }

    .apps-lede {
      margin: 0 0 var(--lede-nudge, 0px);
      font-size: calc(0.42 * var(--fs, 3rem));   /* two lines that mirror the title's two lines */
      line-height: 1.08;
    }

    .apps-list {
      height: var(--rows, auto);
      margin-top: var(--gap, 1.5rem);
      display: grid;
      grid-template-rows: repeat(3, minmax(0, 1fr));
    }

    .app {
      padding: 0.4rem 0;
    }

    .app-art {
      aspect-ratio: auto;
      align-self: stretch;
      min-height: 0;
    }
  }

  @media (max-width: 1024px) {
    .apps-head {
      margin-bottom: 1.5rem;
    }

    .apps-lede {
      margin-bottom: 0;
    }

    .lede-br {
      display: none;
    }

    .applications {
      padding: 1rem 4rem 4rem;
    }
  }

  @media (max-width: 768px) {
    .applications {
      padding: 1rem 1.5rem 3rem 2.5rem;
    }

    .app {
      grid-template-columns: minmax(0, 42%) minmax(0, 1fr);
      gap: 0.9rem;
    }

    .app-line {
      font-size: 0.85rem;
    }
  }

  @media (max-width: 560px) {
    .app {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.5rem;
      padding: 1.1rem 0;
    }

    .app-art {
      aspect-ratio: 2 / 1;
    }

    .app-line {
      max-width: none;
    }
  }

  @media (max-width: 380px) {
    .applications {
      padding: 1rem 1.2rem 3rem;
    }
  }
</style>
