---
// TokamakFieldLines.astro — computed field lines of a spherical tokamak.
// Rendering and physics live in src/lib/tokamak/.
---

<figure class="tokamak">
  <div class="tokamak-view" data-tokamak></div>
  <figcaption class="tokamak-title">Spherical Tokamak</figcaption>
</figure>

<script>
  let current: { destroy(): void } | null = null;

  // start the 3D only when it comes into view (saves work for visitors who never scroll there)
  function whenVisible(el: Element, fn: () => void) {
    if (!('IntersectionObserver' in window)) { fn(); return; }
    const io = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) { io.disconnect(); fn(); }
    }, { rootMargin: '200px' });
    io.observe(el);
  }

  function mountTokamakView() {
    const host = document.querySelector<HTMLElement>('[data-tokamak]');
    if (!host || host.dataset.mounted === 'true') return;
    host.dataset.mounted = 'true';
    whenVisible(host, async () => {
      const { mountTokamak } = await import('../lib/tokamak/fieldlines.js');
      // the page may have been left while the module was loading
      if (!host.isConnected) return;
      current = mountTokamak(host);
    });
  }

  document.addEventListener('astro:page-load', mountTokamakView);
  document.addEventListener('astro:before-swap', () => {
    current?.destroy();
    current = null;
  });
</script>

<style>
  /* square view with the caption right below it; the page sets the width */
  .tokamak {
    position: relative;
    margin: 0;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .tokamak-view {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
  }

  .tokamak-title {
    font-family: 'Barlow', sans-serif;
    font-weight: 400;
    font-size: clamp(1.1rem, 2.1vw, 2rem);
    line-height: 1.1;
    letter-spacing: 0.01em;
    color: #ffffff;
    text-align: center;
    pointer-events: none;
  }
</style>
