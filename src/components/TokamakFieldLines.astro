---
// TokamakFieldLines.astro — computed field lines of a spherical tokamak.
// Rendering and physics live in src/lib/tokamak/.
---

<figure class="tokamak">
  <div class="tokamak-view" data-tokamak></div>
  <figcaption class="tokamak-title">Spherical Tokamak</figcaption>
</figure>

<script>
  let current: { destroy(): void } | null = null;

  async function mountTokamakView() {
    const host = document.querySelector<HTMLElement>('[data-tokamak]');
    if (!host || host.dataset.mounted === 'true') return;
    host.dataset.mounted = 'true';
    const { mountTokamak } = await import('../lib/tokamak/fieldlines.js');
    // the page may have been left while the module was loading
    if (!host.isConnected) return;
    current = mountTokamak(host);
  }

  document.addEventListener('astro:page-load', mountTokamakView);
  document.addEventListener('astro:before-swap', () => {
    current?.destroy();
    current = null;
  });
</script>

<style>
  /* view + caption as one centred block; the caption sits under the animation */
  .tokamak {
    position: relative;
    margin: 0;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }

  .tokamak-view {
    position: relative;
    flex: 0 0 auto;
    height: 60%;
    aspect-ratio: 1 / 1;
    max-width: 100%;
  }

  .tokamak-title {
    font-family: 'Barlow', sans-serif;
    font-weight: 400;
    font-size: clamp(1.1rem, 2.1vw, 2rem);
    line-height: 1.1;
    letter-spacing: 0.01em;
    color: #ffffff;
    text-align: center;
    pointer-events: none;
  }

  /* phones: square view across the width, caption right below */
  @media (max-width: 768px) {
    .tokamak {
      justify-content: flex-start;
    }

    .tokamak-view {
      height: auto;
      width: 100%;
      max-height: calc(100% - 3rem);
    }
  }
</style>
